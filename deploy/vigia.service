# Unidad systemd de Vigía. Destino: /etc/systemd/system/vigia.service en el LXC.
# Según la guía de obra: revisar línea a línea antes de instalar.
# Requiere el sysctl de 99-vigia-ping.conf para que los checks de ping
# funcionen con el usuario sin privilegios.
[Unit]
Description=Vigia homelab monitor
After=network-online.target
Wants=network-online.target

[Service]
User=vigia
EnvironmentFile=/etc/vigia/env
ExecStart=/usr/bin/java -jar /opt/vigia/vigia.jar --vigia.config=/opt/vigia/checks.yml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
